{
  "name": "slotloom",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, white-label availability and meeting follow-up for Cloudflare.",
  "license": "Apache-2.0",
  "keywords": [
    "scheduling",
    "cloudflare-workers",
    "cloudflare-pages",
    "cloudflare-d1",
    "react",
    "open-source"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "wrangler dev --local",
    "dev:setup": "node scripts/setup-dev-env.mjs",
    "build": "tsc -b && vite build",
    "check:structure": "node scripts/check-file-size.mjs",
    "deploy:api": "wrangler deploy",
    "deploy:pages": "pnpm build && wrangler pages deploy dist --project-name slotloom --config wrangler.pages.jsonc",
    "typecheck": "pnpm check:structure && tsc -b --pretty false",
    "test": "vitest run",
    "ci": "pnpm typecheck && pnpm test && pnpm build && pnpm exec wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply example-slotloom-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply example-slotloom-db --remote"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.28.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-day-picker": "^10.0.1",
    "react-dom": "latest",
    "react-email": "^6.9.1",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^26.1.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "prettier": "^3.9.6",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "packageManager": "pnpm@10.28.0"
}
