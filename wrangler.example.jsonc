{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "example-slotloom-api",
  "keep_vars": true,
  "main": "worker/index.ts",
  "tsconfig": "tsconfig.worker.json",
  "compatibility_date": "2026-08-04",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "example-slotloom-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BRAND_ASSETS",
      "bucket_name": "example-slotloom-assets",
    },
  ],
  // Optional when every workspace email is sent through connected OAuth mailboxes.
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTIFICATION_HUB",
        "class_name": "NotificationHub",
      },
    ],
  },
  "exports": {
    "NotificationHub": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "triggers": { "crons": ["17 2 * * *"] },
  "observability": { "enabled": true },
}
